---
import '../styles.css';
import { B, whatsappUrl } from '../data/catalog.js';
import LuxuryHeader from '../components/LuxuryHeader.tsx';
import SmoothScrollProvider from '../components/SmoothScrollProvider.tsx';
import FloatingConciergeBar from '../components/FloatingConciergeBar.tsx';

const {
  title = 'Luxury Spa & Late-Night Wellness in Kalyani Nagar, Pune',
  description = 'Experience restorative massage, candlelit couples suites, and botanical body rituals at The Elite Spa Centre in Kalyani Nagar, Pune. Open daily 8:00 AM – 3:00 AM.',
  image = B.heroPoster,
  imageAlt = 'The Elite Spa Centre luxury sanctuary in Kalyani Nagar, Pune',
  extraStructuredData = []
} = Astro.props;

const siteUrl = new URL('/', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = title + ' | ' + B.name;
const metaDescription = description.length > 160
  ? description.slice(0, 160).replace(/\s+\S*$/, '').trimEnd()
  : description;
const absoluteImage = image.startsWith('http') ? image : new URL(image, Astro.site).href;
const brandLogo = new URL('/images/elite-spa-logo.webp', Astro.site).href;
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [{ name: 'Home', item: siteUrl }];

if (pathSegments[0] === 'services' && pathSegments.length > 1) {
  breadcrumbItems.push({ name: 'Services', item: new URL('/services/', Astro.site).href });
} else if (pathSegments[0] === 'wellness-journal' && pathSegments.length > 1) {
  breadcrumbItems.push({ name: 'Wellness Journal', item: new URL('/wellness-journal/', Astro.site).href });
}
if (pathSegments.length > 0) {
  breadcrumbItems.push({ name: title, item: canonical });
}

const businessId = siteUrl + '#business';
const websiteId = siteUrl + '#website';
const webpageId = canonical + '#webpage';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DaySpa',
      '@id': businessId,
      name: B.name,
      alternateName: 'The Elite Spa Centre | Kalyani Nagar',
      url: siteUrl,
      telephone: B.phone,
      image: absoluteImage,
      logo: brandLogo,
      priceRange: '₹₹',
      address: {
        '@type': 'PostalAddress',
        streetAddress: B.streetAddress,
        addressLocality: 'Pune',
        addressRegion: 'Maharashtra',
        postalCode: B.postalCode,
        addressCountry: 'IN'
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: B.latitude,
        longitude: B.longitude
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '08:00',
          closes: '23:59'
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '00:00',
          closes: '03:00'
        }
      ],
      hasMap: B.maps,
      sameAs: [B.maps],
      areaServed: [
        { '@type': 'Place', name: 'Kalyani Nagar, Pune' },
        { '@type': 'City', name: 'Pune' }
      ]
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: B.name,
      alternateName: 'The Elite Spa Centre Pune',
      inLanguage: 'en-IN',
      publisher: { '@id': businessId }
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonical,
      name: pageTitle,
      description: metaDescription,
      inLanguage: 'en-IN',
      isPartOf: { '@id': websiteId },
      about: { '@id': businessId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: absoluteImage
      },
      ...(pathSegments.length > 0 ? { breadcrumb: { '@id': canonical + '#breadcrumb' } } : {})
    },
    ...(pathSegments.length > 0
      ? [{
          '@type': 'BreadcrumbList',
          '@id': canonical + '#breadcrumb',
          itemListElement: breadcrumbItems.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: item.name,
            item: item.item
          }))
        }]
      : []),
    ...(Array.isArray(extraStructuredData) ? extraStructuredData : [])
  ]
};

const floatWaHref = whatsappUrl('Hello The Elite Spa Centre, I would like to book a spa ritual at your Kalyani Nagar sanctuary.');
---
<!doctype html>
<html lang="en-IN" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0A09" />
    <meta name="application-name" content={B.name} />
    <meta name="author" content={B.name} />
    <meta name="google-site-verification" content="Y5xRYqZLRgu8vEVEo1Qgpv3PZiiriAjXYeESdLXu1yY" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.pexels.com" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={B.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-[#0a0908] text-[#F4EFE6] antialiased selection:bg-[#D4AF7A]/30 selection:text-[#F4EFE6]">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SmoothScrollProvider client:load />
    <LuxuryHeader currentPath={Astro.url.pathname} client:load />

    <div id="main-content">
      <slot />
    </div>

    <!-- Clean Single-Line Local Proximity Note Above Footer -->
    <div class="border-t border-[#D4AF7A]/18 bg-[#161412]/70 py-5">
      <div class="max-w-[1380px] mx-auto px-5 sm:px-8 text-center">
        <p class="text-[15px] sm:text-[16px] text-[#F4EFE6]/90 leading-[1.6]">
          Conveniently located in Kalyani Nagar — minutes away from Koregaon Park, Viman Nagar, Kharadi &amp; Pune Airport.
        </p>
      </div>
    </div>

    <!-- Safe bottom clearance (pb-32 / 128px >= 80px) so floating bar never overlaps copyright or links -->
    <footer class="border-t border-[#D4AF7A]/20 bg-[#0B0A09] pt-20 pb-32 sm:pb-24">
      <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 pb-14 border-b border-[#F4EFE6]/12">
          <div class="md:col-span-5 space-y-5">
            <a href="/" class="inline-block font-serif text-[28px] sm:text-[32px] tracking-[0.1em] uppercase text-[#F4EFE6] hover:text-[#D4AF7A] transition-colors">
              The Elite Spa Centre
            </a>
            <p class="text-[17px] text-[#F4EFE6]/90 leading-[1.6] max-w-md">
              Kalyani Nagar’s candlelit dark-luxury sanctuary for restorative massage, private couples suites, and pure botanical wellness.
            </p>
            <p class="text-[16px] font-semibold text-[#E5C158] pt-1">
              Open Daily · 8:00 AM – 3:00 AM
            </p>
          </div>

          <div class="md:col-span-3 space-y-4">
            <h2 class="font-sans text-[16px] font-semibold tracking-[0.06em] uppercase text-[#D4AF7A]">Sanctuary</h2>
            <ul class="space-y-3 text-[16px] text-[#F4EFE6]/90">
              <li><a href="/services/" class="hover:text-[#E5C158] transition-colors">Signature Rituals</a></li>
              <li><a href="/offers/" class="hover:text-[#E5C158] transition-colors">Curated Bundles</a></li>
              <li><a href="/gallery/" class="hover:text-[#E5C158] transition-colors">Sensory Gallery</a></li>
              <li><a href="/shop/" class="hover:text-[#E5C158] transition-colors">Apothecary Shop</a></li>
              <li><a href="/about/" class="hover:text-[#E5C158] transition-colors">About Us</a></li>
              <li><a href="/wellness-journal/" class="hover:text-[#E5C158] transition-colors">Wellness Journal</a></li>
            </ul>
          </div>

          <div class="md:col-span-4 space-y-4">
            <h2 class="font-sans text-[16px] font-semibold tracking-[0.06em] uppercase text-[#D4AF7A]">Concierge &amp; Directions</h2>
            <p class="text-[17px] text-[#F4EFE6]/90 leading-[1.6]">{B.address}</p>
            <div class="pt-2 flex flex-col gap-3 text-[16px]">
              <a href={`tel:${B.phone}`} class="text-[#F4EFE6] hover:text-[#E5C158] font-semibold transition-colors">
                {B.phoneDisplay}
              </a>
              <a href={B.maps} target="_blank" rel="noopener noreferrer" class="text-[#E5C158] hover:text-[#F0D58C] font-medium transition-colors">
                Get Directions on Google Maps ↗
              </a>
              <a href={floatWaHref} target="_blank" rel="noopener noreferrer" class="text-[#F4EFE6]/90 hover:text-[#E5C158] transition-colors">
                Message Concierge on WhatsApp ↗
              </a>
            </div>
          </div>
        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-[15px] text-[#F4EFE6]/90">
          <span>© {new Date().getFullYear()} The Elite Spa Centre, Kalyani Nagar, Pune.</span>
          <div class="flex flex-wrap items-center gap-6">
            <a href="/privacy/" class="hover:text-[#E5C158] transition-colors">Privacy Policy</a>
            <a href="/terms/" class="hover:text-[#E5C158] transition-colors">Terms</a>
            <a href="/booking/" class="text-[#E5C158] hover:text-[#F0D58C] font-medium transition-colors">Book a Ritual</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Scroll-Triggered Sticky Concierge Bar (Hidden on Hero Load, Slides Up Past Hero) -->
    <FloatingConciergeBar client:load />
  </body>
</html>
