---
import '../styles.css';
import { B, whatsappUrl } from '../data/catalog.js';
import LuxuryHeader from '../components/LuxuryHeader.tsx';
import SmoothScrollProvider from '../components/SmoothScrollProvider.tsx';

const {
  title = 'Luxury Spa & Late-Night Wellness in Kalyani Nagar, Pune',
  description = 'Experience restorative massage, candlelit couples suites, and botanical body rituals at The Elite Spa Centre in Kalyani Nagar, Pune. Open daily 8:00 AM – 3:00 AM.',
  image = B.heroPoster,
  imageAlt = 'The Elite Spa Centre luxury sanctuary in Kalyani Nagar, Pune',
  extraStructuredData = []
} = Astro.props;

const siteUrl = new URL('/', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = title + ' | ' + B.name;
const metaDescription = description.length > 160
  ? description.slice(0, 160).replace(/\s+\S*$/, '').trimEnd()
  : description;
const absoluteImage = image.startsWith('http') ? image : new URL(image, Astro.site).href;
const brandLogo = new URL('/images/elite-spa-logo.webp', Astro.site).href;
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [{ name: 'Home', item: siteUrl }];

if (pathSegments[0] === 'services' && pathSegments.length > 1) {
  breadcrumbItems.push({ name: 'Services', item: new URL('/services/', Astro.site).href });
} else if (pathSegments[0] === 'wellness-journal' && pathSegments.length > 1) {
  breadcrumbItems.push({ name: 'Wellness Journal', item: new URL('/wellness-journal/', Astro.site).href });
}
if (pathSegments.length > 0) {
  breadcrumbItems.push({ name: title, item: canonical });
}

const businessId = siteUrl + '#business';
const websiteId = siteUrl + '#website';
const webpageId = canonical + '#webpage';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DaySpa',
      '@id': businessId,
      name: B.name,
      alternateName: 'The Elite Spa Centre | Kalyani Nagar',
      url: siteUrl,
      telephone: B.phone,
      image: absoluteImage,
      logo: brandLogo,
      priceRange: '₹₹',
      address: {
        '@type': 'PostalAddress',
        streetAddress: B.streetAddress,
        addressLocality: 'Pune',
        addressRegion: 'Maharashtra',
        postalCode: B.postalCode,
        addressCountry: 'IN'
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: B.latitude,
        longitude: B.longitude
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '08:00',
          closes: '23:59'
        },
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
          opens: '00:00',
          closes: '03:00'
        }
      ],
      hasMap: B.maps,
      sameAs: [B.maps],
      areaServed: [
        { '@type': 'Place', name: 'Kalyani Nagar, Pune' },
        { '@type': 'City', name: 'Pune' }
      ]
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: B.name,
      alternateName: 'The Elite Spa Centre Pune',
      inLanguage: 'en-IN',
      publisher: { '@id': businessId }
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonical,
      name: pageTitle,
      description: metaDescription,
      inLanguage: 'en-IN',
      isPartOf: { '@id': websiteId },
      about: { '@id': businessId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: absoluteImage
      },
      ...(pathSegments.length > 0 ? { breadcrumb: { '@id': canonical + '#breadcrumb' } } : {})
    },
    ...(pathSegments.length > 0
      ? [{
          '@type': 'BreadcrumbList',
          '@id': canonical + '#breadcrumb',
          itemListElement: breadcrumbItems.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: item.name,
            item: item.item
          }))
        }]
      : []),
    ...(Array.isArray(extraStructuredData) ? extraStructuredData : [])
  ]
};

const floatWaHref = whatsappUrl('Hello The Elite Spa Centre, I would like to book a spa session at your Kalyani Nagar sanctuary.');
---
<!doctype html>
<html lang="en-IN" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09090B" />
    <meta name="application-name" content={B.name} />
    <meta name="author" content={B.name} />
    <meta name="google-site-verification" content="Y5xRYqZLRgu8vEVEo1Qgpv3PZiiriAjXYeESdLXu1yY" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.pexels.com" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={B.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-[#09090B] text-[#F5F5F0] antialiased selection:bg-[#D4AF37]/30 selection:text-[#F5F5F0]">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SmoothScrollProvider client:load />
    <LuxuryHeader currentPath={Astro.url.pathname} client:load />

    <div id="main-content">
      <slot />
    </div>

    <footer class="border-t border-[#D4AF37]/20 bg-[#09090B] pt-16 pb-28 sm:pb-12">
      <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12 pb-12 border-b border-[#F5F5F0]/10">
          <div class="md:col-span-5 space-y-4">
            <a href="/" class="inline-block font-serif text-2xl sm:text-3xl tracking-[0.14em] uppercase text-[#F5F5F0] hover:text-[#D4AF37] transition-colors">
              The Elite Spa Centre
            </a>
            <p class="text-sm text-[#B0AEA6] leading-relaxed max-w-sm">
              Kalyani Nagar’s dark-luxury sanctuary for restorative massage, candlelit couples suites, and pure botanical wellness — open daily until 3:00 AM.
            </p>
            <p class="text-xs font-semibold tracking-[0.16em] uppercase text-[#D4AF37] pt-1">
              Open Daily · 8:00 AM – 3:00 AM
            </p>
          </div>

          <div class="md:col-span-3 space-y-3">
            <h2 class="font-sans text-xs font-semibold tracking-[0.18em] uppercase text-[#D4AF37]">Explore</h2>
            <ul class="space-y-2.5 text-sm text-[#B0AEA6]">
              <li><a href="/services/" class="hover:text-[#F5F5F0] transition-colors">Curated Rituals</a></li>
              <li><a href="/offers/" class="hover:text-[#F5F5F0] transition-colors">Privilege Bundles</a></li>
              <li><a href="/shop/" class="hover:text-[#F5F5F0] transition-colors">Wellness Apothecary</a></li>
              <li><a href="/gallery/" class="hover:text-[#F5F5F0] transition-colors">Sensory Gallery</a></li>
              <li><a href="/wellness-journal/" class="hover:text-[#F5F5F0] transition-colors">Wellness Journal</a></li>
              <li><a href="/nearby-areas/" class="hover:text-[#F5F5F0] transition-colors">Nearby Pune Areas</a></li>
              <li><a href="/about/" class="hover:text-[#F5F5F0] transition-colors">Our Philosophy</a></li>
            </ul>
          </div>

          <div class="md:col-span-4 space-y-3">
            <h2 class="font-sans text-xs font-semibold tracking-[0.18em] uppercase text-[#D4AF37]">Sanctuary Concierge</h2>
            <p class="text-sm text-[#B0AEA6] leading-relaxed">{B.address}</p>
            <div class="pt-2 flex flex-col gap-2 text-sm">
              <a href={`tel:${B.phone}`} class="text-[#F5F5F0] hover:text-[#D4AF37] font-medium transition-colors">
                {B.phoneDisplay}
              </a>
              <a href={B.maps} target="_blank" rel="noopener noreferrer" class="text-[#D4AF37] hover:text-[#E8CB6D] transition-colors">
                Get Directions on Google Maps ↗
              </a>
              <a href={floatWaHref} target="_blank" rel="noopener noreferrer" class="text-[#F5F5F0]/80 hover:text-[#D4AF37] transition-colors">
                WhatsApp Concierge ↗
              </a>
            </div>
          </div>
        </div>

        <div class="pt-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-[#B0AEA6]">
          <span>© {new Date().getFullYear()} The Elite Spa Centre, Kalyani Nagar, Pune. All rights reserved.</span>
          <div class="flex items-center gap-5">
            <a href="/privacy/" class="hover:text-[#F5F5F0] transition-colors">Privacy Policy</a>
            <a href="/terms/" class="hover:text-[#F5F5F0] transition-colors">Terms</a>
            <a href="/booking/" class="hover:text-[#D4AF37] transition-colors">Book a Ritual</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Neatly Aligned Bottom-Right Floating Action Buttons (Zero Text Overlap) -->
    <div
      class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-30 flex flex-row sm:flex-col items-center sm:items-end gap-2.5"
      aria-label="Quick contact actions"
    >
      <a
        href={floatWaHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Book on WhatsApp"
        class="inline-flex items-center gap-2 px-4 py-2.5 sm:px-5 sm:py-3 rounded-full bg-[#15803D] hover:bg-[#16A34A] text-white text-xs font-semibold tracking-wide shadow-[0_8px_28px_rgba(0,0,0,0.45)] border border-white/15 transition-transform duration-200 hover:-translate-y-0.5 whitespace-nowrap"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
        <span>WhatsApp</span>
      </a>
      <a
        href={`tel:${B.phone}`}
        aria-label="Call The Elite Spa Centre"
        class="inline-flex items-center gap-2 px-4 py-2.5 sm:px-5 sm:py-3 rounded-full bg-[#121215]/95 hover:bg-[#1A1A1F] backdrop-blur-md text-[#F5F5F0] text-xs font-semibold tracking-wide shadow-[0_8px_28px_rgba(0,0,0,0.45)] border border-[#D4AF37]/45 hover:border-[#D4AF37] transition-transform duration-200 hover:-translate-y-0.5 whitespace-nowrap"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#D4AF37" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span>Call Now</span>
      </a>
    </div>
  </body>
</html>
