---
import '../styles.css';
import { B } from '../data/catalog.js';

const {
  title = 'Luxury Spa & Wellness in Kalyani Nagar, Pune',
  description = 'Explore massage, spa and wellness experiences at The Elite Spa Centre in Kalyani Nagar, Pune. Enquire by phone or WhatsApp.',
  image = 'https://images.pexels.com/photos/7031704/pexels-photo-7031704.jpeg?auto=compress&w=1260&h=750&dpr=1'
} = Astro.props;

const siteUrl = new URL('/', Astro.site).href;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = title + ' | ' + B.name;
const metaDescription = description.length > 160 ? description.slice(0, 157).trimEnd() + '…' : description;
const absoluteImage = image.startsWith('http') ? image : new URL(image, Astro.site).href;
const brandLogo = new URL('/images/elite-spa-logo.webp', Astro.site).href;
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [{ name: 'Home', item: siteUrl }];

if (pathSegments[0] === 'services' && pathSegments.length > 1) {
  breadcrumbItems.push({ name: 'Services', item: new URL('/services/', Astro.site).href });
} else if (pathSegments[0] === 'wellness-journal' && pathSegments.length > 1) {
  breadcrumbItems.push({ name: 'Wellness Journal', item: new URL('/wellness-journal/', Astro.site).href });
}
if (pathSegments.length > 0) {
  breadcrumbItems.push({ name: title, item: canonical });
}

const businessId = siteUrl + '#business';
const websiteId = siteUrl + '#website';
const webpageId = canonical + '#webpage';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DaySpa',
      '@id': businessId,
      name: B.name,
      alternateName: 'The Elite spa centre | Kalyani Nagar',
      url: siteUrl,
      telephone: B.phone,
      image: absoluteImage,
      logo: brandLogo,
      address: {
        '@type': 'PostalAddress',
        streetAddress: B.address,
        addressLocality: 'Pune',
        addressRegion: 'Maharashtra',
        postalCode: '411014',
        addressCountry: 'IN'
      },
      openingHours: 'Mo-Su 07:00-02:00',
      hasMap: B.maps,
      sameAs: [B.maps],
      areaServed: {
        '@type': 'City',
        name: 'Pune'
      }
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl,
      name: B.name,
      alternateName: 'The Elite Spa Centre Pune',
      inLanguage: 'en-IN',
      publisher: { '@id': businessId }
    },
    {
      '@type': 'WebPage',
      '@id': webpageId,
      url: canonical,
      name: pageTitle,
      description: metaDescription,
      inLanguage: 'en-IN',
      isPartOf: { '@id': websiteId },
      about: { '@id': businessId },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: absoluteImage
      },
      ...(pathSegments.length > 0 ? { breadcrumb: { '@id': canonical + '#breadcrumb' } } : {})
    },
    ...(pathSegments.length > 0
      ? [{
          '@type': 'BreadcrumbList',
          '@id': canonical + '#breadcrumb',
          itemListElement: breadcrumbItems.map((item, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            name: item.name,
            item: item.item
          }))
        }]
      : [])
  ]
};
---
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#17261f" />
    <meta name="application-name" content={B.name} />
    <meta name="google-site-verification" content="Y5xRYqZLRgu8vEVEo1Qgpv3PZiiriAjXYeESdLXu1yY" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.pexels.com" />
    <title>{pageTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={B.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={brandLogo} />
    <meta property="og:image:alt" content="Elite Spa botanical logo with green leaves, spa stones and a white plumeria flower" />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={brandLogo} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header>
      <a class="brand" href="/" aria-label="Elite Spa Centre home"><img class="brand-logo" src="/images/elite-spa-logo.webp" alt="Elite Spa Centre · Kalyani Nagar" width="640" height="347" fetchpriority="high" /></a>
      <nav aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/services/">Services</a>
        <a href="/offers/">Offers</a>
        <a href="/shop/">Wellness shop</a>
        <a href="/gallery/">Gallery</a>
        <a href="/wellness-journal/">Journal</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a class="gold nav-book" href="/booking/">Book now ↗</a>
      </nav>
    </header>
    <slot />
    <footer>
      <div class="footer-grid">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="Elite Spa Centre home"><img class="brand-logo" src="/images/elite-spa-logo.webp" alt="Elite Spa Centre" width="640" height="347" loading="lazy" /></a>
          <p>A place to slow down, explore wellness rituals and make a little space for yourself in Kalyani Nagar, Pune.</p>
        </div>
        <div>
          <b>EXPLORE</b>
          <a href="/services/">Services</a>
          <a href="/offers/">Suggested bundles</a>
          <a href="/shop/">Wellness shop</a>
          <a href="/gallery/">Gallery</a>
          <a href="/wellness-journal/">Wellness journal</a>
        </div>
        <div>
          <b>PLAN A VISIT</b>
          <p>{B.address}</p>
          <p>Daily · 7:00 AM – 2:00 AM</p>
          <a href={B.maps} target="_blank" rel="noopener noreferrer">View on Google Maps ↗</a>
          <a href="tel:+919199561258">+91 91995 61258</a>
          <a href="https://wa.me/919199561258?text=Hello%20The%20Elite%20Spa%20Centre" target="_blank" rel="noopener noreferrer">WhatsApp the team ↗</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} The Elite Spa Centre</span>
        <span><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
        <span>Illustrative stock imagery is labelled where used.</span>
      </div>
    </footer>
    <div class="floating-actions">
      <a class="float-wa" href="https://wa.me/919199561258?text=Hello%20The%20Elite%20Spa%20Centre" target="_blank" rel="noopener noreferrer" aria-label="Chat with The Elite Spa Centre on WhatsApp">☏ <span>WhatsApp</span></a>
      <a class="float-call" href="tel:+919199561258" aria-label="Call The Elite Spa Centre">☎ <span>Call now</span></a>
    </div>
  </body>
</html>
