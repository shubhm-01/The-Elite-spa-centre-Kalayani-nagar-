---
import Base from '../../layouts/Base.astro';
import { whatsappUrl } from '../../data/catalog.js';
---
<Base
  title="Our Philosophy | The Elite Spa Centre, Kalyani Nagar"
  description="Discover the restorative philosophy behind The Elite Spa Centre at Vascon Mariplex Mall, Kalyani Nagar, Pune — open daily from 8:00 AM to 3:00 AM."
>
  <section class="pt-36 pb-20 sm:pt-44 sm:pb-24 border-b border-[#E5C158]/20 bg-gradient-to-b from-[#121215] to-[#09090B]">
    <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
      <h1 class="font-serif text-[44px] sm:text-[56px] lg:text-[68px] font-medium text-[#F5F5F0] leading-[1.04] mb-6">
        Wellness, Crafted With <em class="italic font-normal text-[#E5C158]">Intention.</em>
      </h1>
      <p class="text-[18px] text-[#F5F5F0]/90 max-w-2xl leading-[1.6]">
        An acoustic dark-luxury sanctuary in Kalyani Nagar built for unhurried restoration — from quiet morning rituals to midnight decompression.
      </p>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-20 sm:py-28 space-y-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <article class="glass-panel rounded-3xl p-8 space-y-4">
        <span class="font-serif text-[36px] text-[#E5C158] leading-none block">01</span>
        <h2 class="font-serif text-[28px] text-[#F5F5F0]">Bespoke Pressure &amp; Oils</h2>
        <p class="text-[17px] text-[#F5F5F0]/90 leading-[1.6]">
          Every session opens with a tailored consultation on pressure, focus zones, and pure botanical oil blends suited to your mood.
        </p>
      </article>

      <article class="glass-panel rounded-3xl p-8 space-y-4">
        <span class="font-serif text-[36px] text-[#E5C158] leading-none block">02</span>
        <h2 class="font-serif text-[28px] text-[#F5F5F0]">Late-Night Sanctuary</h2>
        <p class="text-[17px] text-[#F5F5F0]/90 leading-[1.6]">
          Open every day from 8:00 AM until 3:00 AM, welcoming late-evening travelers, founders, and couples whenever calm is needed most.
        </p>
      </article>

      <article class="glass-panel rounded-3xl p-8 space-y-4">
        <span class="font-serif text-[36px] text-[#E5C158] leading-none block">03</span>
        <h2 class="font-serif text-[28px] text-[#F5F5F0]">Impeccable Hygiene</h2>
        <p class="text-[17px] text-[#F5F5F0]/90 leading-[1.6]">
          Private candlelit suites refreshed with crisp linens, warm towels, and certified therapists dedicated to five-star hospitality.
        </p>
      </article>
    </div>

    <section class="glass-panel rounded-3xl p-8 sm:p-12 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
      <div class="max-w-xl space-y-3">
        <h2 class="font-serif text-[34px] sm:text-[42px] text-[#F5F5F0] leading-tight">
          Ready for your next moment of <em class="italic font-normal text-[#E5C158]">stillness?</em>
        </h2>
        <p class="text-[17px] text-[#F5F5F0]/90 leading-[1.6]">
          Explore our curated menu starting at ₹999, or message our Kalyani Nagar concierge for instant suite availability.
        </p>
      </div>
      <div class="flex flex-wrap gap-4 shrink-0">
        <a
          href="/services/"
          class="py-4 px-7 rounded-full border border-[#E5C158]/50 hover:border-[#E5C158] text-[#F5F5F0] text-[16px] font-semibold transition-colors"
        >
          Explore Rituals
        </a>
        <a
          href={whatsappUrl('Hello The Elite Spa Centre, I would like to book a sanctuary ritual in Kalyani Nagar.')}
          target="_blank"
          rel="noopener noreferrer"
          class="py-4 px-7 rounded-full bg-[#E5C158] hover:bg-[#F2D77E] text-[#09090B] text-[16px] font-semibold transition-colors"
        >
          Book on WhatsApp →
        </a>
      </div>
    </section>
  </main>
</Base>
