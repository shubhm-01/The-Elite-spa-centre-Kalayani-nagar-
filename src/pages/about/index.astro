---
import Base from '../../layouts/Base.astro';
import { B, whatsappUrl } from '../../data/catalog.js';
---
<Base
  title="Our Philosophy | The Elite Spa Centre, Kalyani Nagar"
  description="Discover the restorative philosophy behind The Elite Spa Centre at Vascon Mariplex Mall, Kalyani Nagar, Pune — open daily from 8:00 AM to 3:00 AM."
>
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20 border-b border-[#D4AF37]/15 bg-gradient-to-b from-[#121215] to-[#09090B]">
    <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
      <p class="text-xs font-semibold tracking-[0.22em] uppercase text-[#D4AF37] mb-3">
        Our Philosophy
      </p>
      <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-medium text-[#F5F5F0] leading-[1.04] mb-6">
        Wellness, Crafted With <em class="italic font-normal text-[#D4AF37]">Intention.</em>
      </h1>
      <p class="text-base sm:text-lg text-[#B0AEA6] max-w-2xl leading-relaxed">
        An acoustic dark-luxury sanctuary in the heart of Kalyani Nagar designed for unhurried restoration — from quiet morning rituals to midnight decompression.
      </p>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-16 sm:py-24 space-y-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <article class="glass-panel rounded-3xl p-8 space-y-3">
        <span class="font-serif text-3xl text-[#D4AF37]">01</span>
        <h2 class="font-serif text-2xl text-[#F5F5F0]">Bespoke Pressure &amp; Oils</h2>
        <p class="text-sm text-[#B0AEA6] leading-relaxed">
          Every treatment opens with a tailored consultation covering pressure preference, focus areas, and pure botanical oil blends suited to your mood.
        </p>
      </article>

      <article class="glass-panel rounded-3xl p-8 space-y-3">
        <span class="font-serif text-3xl text-[#D4AF37]">02</span>
        <h2 class="font-serif text-2xl text-[#F5F5F0]">Late-Night Sanctuary</h2>
        <p class="text-sm text-[#B0AEA6] leading-relaxed">
          Open every day from 8:00 AM until 3:00 AM, welcoming late-evening travelers, busy founders, and couples whenever calm is needed most.
        </p>
      </article>

      <article class="glass-panel rounded-3xl p-8 space-y-3">
        <span class="font-serif text-3xl text-[#D4AF37]">03</span>
        <h2 class="font-serif text-2xl text-[#F5F5F0]">Impeccable Hygiene</h2>
        <p class="text-sm text-[#B0AEA6] leading-relaxed">
          Private candlelit suites refreshed with crisp linens, warm towels, and certified professional therapists dedicated to authentic wellness hospitality.
        </p>
      </article>
    </div>

    <section class="glass-panel rounded-3xl p-8 sm:p-12 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
      <div class="max-w-xl space-y-3">
        <span class="text-xs font-semibold tracking-[0.18em] uppercase text-[#D4AF37]">Vascon Mariplex Mall · Kalyani Nagar</span>
        <h2 class="font-serif text-3xl sm:text-4xl text-[#F5F5F0]">Ready for your next moment of stillness?</h2>
        <p class="text-sm text-[#B0AEA6] leading-relaxed">
          Explore our menu of 26 curated rituals starting at ₹999, or message our concierge for instant suite availability.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a
          href="/services/"
          class="px-6 py-3.5 rounded-full border border-[#D4AF37]/40 hover:border-[#D4AF37] text-[#F5F5F0] text-xs font-semibold tracking-[0.12em] uppercase transition-colors"
        >
          Explore Rituals
        </a>
        <a
          href={whatsappUrl('Hello The Elite Spa Centre, I would like to book a sanctuary ritual in Kalyani Nagar.')}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-full bg-[#D4AF37] hover:bg-[#E8CB6D] text-[#09090B] text-xs font-bold tracking-[0.12em] uppercase transition-colors"
        >
          Book on WhatsApp ↗
        </a>
      </div>
    </section>
  </main>
</Base>
