---
import Base from '../../layouts/Base.astro';
import { B, whatsappUrl } from '../../data/catalog.js';
---
<Base
  title="Location & Concierge | Vascon Mariplex Mall, Kalyani Nagar"
  description="Visit The Elite Spa Centre at Ground Floor, Vascon Mariplex Mall, Cybage Tower Road, next to Taco Bell, Kalyani Nagar, Pune 411014. Open daily 8:00 AM – 3:00 AM."
>
  <section class="pt-36 pb-20 sm:pt-44 sm:pb-28 max-w-[1380px] mx-auto px-5 sm:px-8">
    <h1 class="font-serif text-[44px] sm:text-[56px] lg:text-[68px] font-medium text-[#F5F5F0] leading-[1.04] mb-12">
      Visit Us in <em class="italic font-normal text-[#E5C158]">Kalyani Nagar.</em>
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <div class="lg:col-span-5 glass-panel rounded-3xl p-8 sm:p-10 flex flex-col justify-between gap-8">
        <div class="space-y-6">
          <h2 class="font-serif text-[32px] sm:text-[36px] text-[#F5F5F0]">Vascon Mariplex Mall</h2>

          <div class="space-y-5 text-[17px] text-[#F5F5F0]/90 leading-[1.6]">
            <div>
              <strong class="block text-[15px] font-semibold text-[#E5C158] mb-1">Address</strong>
              <p>{B.address}</p>
            </div>
            <div>
              <strong class="block text-[15px] font-semibold text-[#E5C158] mb-1">Opening Hours</strong>
              <p class="text-[#F5F5F0] font-semibold">Open Daily • 8:00 AM – 3:00 AM (Late Night Spa)</p>
            </div>
            <div>
              <strong class="block text-[15px] font-semibold text-[#E5C158] mb-1">Phone &amp; WhatsApp</strong>
              <a href={`tel:${B.phone}`} class="text-[20px] text-[#F5F5F0] hover:text-[#E5C158] font-semibold transition-colors">
                {B.phoneDisplay}
              </a>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3.5 pt-6 border-t border-[#F5F5F0]/12">
          <a
            href={B.maps}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center py-4 px-6 rounded-full bg-[#E5C158] hover:bg-[#F2D77E] text-[#09090B] text-[16px] font-semibold transition-colors whitespace-nowrap"
          >
            Get Directions ↗
          </a>
          <a
            href={whatsappUrl('Hello The Elite Spa Centre, I am heading to your Vascon Mariplex Mall sanctuary and would like to book a session.')}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center py-4 px-6 rounded-full border border-[#E5C158]/50 hover:border-[#E5C158] text-[#F5F5F0] text-[16px] font-semibold transition-colors whitespace-nowrap"
          >
            WhatsApp Now
          </a>
        </div>
      </div>

      <div class="lg:col-span-7 rounded-3xl overflow-hidden border border-[#E5C158]/25 bg-[#121215] min-h-[420px]">
        <iframe
          title="The Elite Spa Centre at Vascon Mariplex Mall, Kalyani Nagar, Pune"
          src="https://www.google.com/maps?q=Vascon+Mariplex+Mall,+Cybage+Tower+Road,+Kalyani+Nagar,+Pune+411014&z=16&output=embed"
          loading="lazy"
          referrerPolicy="no-referrer-when-downgrade"
          class="dark-map-frame w-full h-full min-h-[420px] border-0"
        />
      </div>
    </div>
  </section>
</Base>
