---
import Base from '../../layouts/Base.astro';
import { B } from '../../data/catalog.js';
---
<Base
  title="Spa Location & Contact in Kalyani Nagar, Pune"
  description="Find The Elite Spa Centre at Vascon Mariplex Mall, Kalyani Nagar, Pune. View directions, phone number and daily opening hours."
>
  <section class="page">
    <small>WE'RE HERE FOR YOU</small>
    <h1>Come find <i>your calm.</i></h1>
  </section>
  <main id="main-content">
    <h2>{B.name}</h2>
    <p>{B.address}</p>
    <p>Phone &amp; WhatsApp: <a href="tel:+919199561258">+91 9199561258</a></p>
    <p>Every day · {B.hours}</p>
    <a class="btn" href={B.maps} target="_blank" rel="noopener noreferrer">Google Maps directions ↗</a>
    <iframe title="Map showing The Elite Spa Centre at Vascon Mariplex Mall, Kalyani Nagar, Pune" src={'https://www.google.com/maps?q=' + B.latitude + ',' + B.longitude + '&z=17&output=embed'} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
  </main>
</Base>
