---
import Base from '../../layouts/Base.astro';
import { B, whatsappUrl } from '../../data/catalog.js';
---
<Base
  title="Location & Concierge | Vascon Mariplex Mall, Kalyani Nagar"
  description="Visit The Elite Spa Centre at Ground Floor, Vascon Mariplex Mall, Cybage Tower Road, next to Taco Bell, Kalyani Nagar, Pune 411014. Open daily 8:00 AM – 3:00 AM."
>
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-24 max-w-[1380px] mx-auto px-5 sm:px-8">
    <p class="text-xs font-semibold tracking-[0.22em] uppercase text-[#D4AF37] mb-3">
      Visit The Sanctuary
    </p>
    <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-medium text-[#F5F5F0] leading-[1.04] mb-12">
      Find Your Calm in <em class="italic font-normal text-[#D4AF37]">Kalyani Nagar.</em>
    </h1>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      <div class="lg:col-span-5 glass-panel rounded-3xl p-7 sm:p-9 flex flex-col justify-between space-y-8">
        <div class="space-y-6">
          <div>
            <span class="text-xs font-semibold tracking-[0.16em] uppercase text-[#D4AF37]">
              {B.name}
            </span>
            <h2 class="font-serif text-3xl text-[#F5F5F0] mt-2">Vascon Mariplex Mall</h2>
          </div>

          <div class="space-y-4 text-sm text-[#B0AEA6]">
            <div>
              <strong class="block text-xs tracking-[0.14em] uppercase text-[#F5F5F0] mb-1">Address</strong>
              <p class="leading-relaxed">{B.address}</p>
            </div>
            <div>
              <strong class="block text-xs tracking-[0.14em] uppercase text-[#F5F5F0] mb-1">Opening Hours</strong>
              <p class="text-[#D4AF37] font-medium">Open Daily · 8:00 AM – 3:00 AM (Late Night Spa)</p>
            </div>
            <div>
              <strong class="block text-xs tracking-[0.14em] uppercase text-[#F5F5F0] mb-1">Phone &amp; WhatsApp</strong>
              <a href={`tel:${B.phone}`} class="text-base text-[#F5F5F0] hover:text-[#D4AF37] font-medium transition-colors">
                {B.phoneDisplay}
              </a>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-4 border-t border-[#F5F5F0]/10">
          <a
            href={B.maps}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center px-5 py-3.5 rounded-full bg-[#D4AF37] hover:bg-[#E8CB6D] text-[#09090B] text-xs font-bold tracking-[0.1em] uppercase transition-colors"
          >
            Get Directions ↗
          </a>
          <a
            href={whatsappUrl('Hello The Elite Spa Centre, I am heading to your Vascon Mariplex Mall sanctuary and would like to book a session.')}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center px-5 py-3.5 rounded-full border border-[#D4AF37]/40 hover:border-[#D4AF37] text-[#F5F5F0] text-xs font-semibold tracking-[0.1em] uppercase transition-colors"
          >
            WhatsApp Now
          </a>
        </div>
      </div>

      <div class="lg:col-span-7 rounded-3xl overflow-hidden border border-[#D4AF37]/25 bg-[#121215] min-h-[400px]">
        <iframe
          title="The Elite Spa Centre at Vascon Mariplex Mall, Kalyani Nagar, Pune"
          src="https://www.google.com/maps?q=Vascon+Mariplex+Mall,+Cybage+Tower+Road,+Kalyani+Nagar,+Pune+411014&z=16&output=embed"
          loading="lazy"
          referrerPolicy="no-referrer-when-downgrade"
          class="dark-map-frame w-full h-full min-h-[400px] border-0"
        />
      </div>
    </div>
  </section>
</Base>
