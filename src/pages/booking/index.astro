---
import Base from '../../layouts/Base.astro';
import Booking from '../../components/Booking.jsx';
import { B } from '../../data/catalog.js';
---
<Base
  title="Reserve Your Spa Ritual in Kalyani Nagar, Pune"
  description="Reserve your spa session at The Elite Spa Centre, Vascon Mariplex Mall, Kalyani Nagar, Pune. Open daily 8:00 AM – 3:00 AM with instant WhatsApp confirmation."
>
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-24 max-w-[1380px] mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-5 space-y-6">
        <p class="text-xs font-semibold tracking-[0.22em] uppercase text-[#D4AF37]">
          Instant Concierge Reservation
        </p>
        <h1 class="font-serif text-5xl sm:text-6xl font-medium text-[#F5F5F0] leading-[1.04]">
          Reserve Your <em class="italic font-normal text-[#D4AF37]">Escape.</em>
        </h1>
        <p class="text-base text-[#B0AEA6] leading-relaxed">
          Choose your ritual, preferred duration, and ideal time — including late-night slots until 3:00 AM. Our Kalyani Nagar concierge confirms your private suite directly on WhatsApp.
        </p>

        <div class="glass-panel-subtle rounded-2xl p-6 space-y-4 text-sm">
          <div>
            <span class="block text-xs tracking-[0.14em] uppercase text-[#D4AF37] mb-1">Hours</span>
            <p class="text-[#F5F5F0] font-medium">Open Daily · 8:00 AM – 3:00 AM</p>
          </div>
          <div>
            <span class="block text-xs tracking-[0.14em] uppercase text-[#D4AF37] mb-1">Sanctuary Address</span>
            <p class="text-[#B0AEA6] leading-relaxed">{B.address}</p>
          </div>
          <div>
            <span class="block text-xs tracking-[0.14em] uppercase text-[#D4AF37] mb-1">Direct Concierge</span>
            <a href={`tel:${B.phone}`} class="text-[#F5F5F0] hover:text-[#D4AF37] font-medium transition-colors">
              {B.phoneDisplay}
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <Booking client:load />
      </div>
    </div>
  </section>
</Base>
