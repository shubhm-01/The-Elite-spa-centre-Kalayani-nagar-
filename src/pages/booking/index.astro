---
import Base from '../../layouts/Base.astro';
import Booking from '../../components/Booking.jsx';
import { B } from '../../data/catalog.js';
---
<Base
  title="Reserve Your Spa Ritual in Kalyani Nagar, Pune"
  description="Reserve your spa session at The Elite Spa Centre, Vascon Mariplex Mall, Kalyani Nagar, Pune. Open daily 8:00 AM – 3:00 AM with instant WhatsApp confirmation."
>
  <section class="pt-36 pb-20 sm:pt-44 sm:pb-28 max-w-[1380px] mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-5 space-y-6">
        <h1 class="font-serif text-[44px] sm:text-[56px] lg:text-[64px] font-medium text-[#F5F5F0] leading-[1.04]">
          Reserve Your <em class="italic font-normal text-[#E5C158]">Escape.</em>
        </h1>
        <p class="text-[18px] text-[#F5F5F0]/90 leading-[1.6]">
          Select your ritual, duration, and preferred time — including late-night sessions until 3:00 AM. Our Kalyani Nagar concierge confirms your suite directly on WhatsApp.
        </p>

        <div class="glass-panel-subtle rounded-3xl p-7 space-y-5 text-[17px]">
          <div>
            <strong class="block text-[15px] font-semibold text-[#E5C158] mb-1">Opening Hours</strong>
            <p class="text-[#F5F5F0] font-semibold">Open Daily • 8:00 AM – 3:00 AM</p>
          </div>
          <div>
            <strong class="block text-[15px] font-semibold text-[#E5C158] mb-1">Sanctuary Address</strong>
            <p class="text-[#F5F5F0]/90 leading-[1.6]">{B.address}</p>
          </div>
          <div>
            <strong class="block text-[15px] font-semibold text-[#E5C158] mb-1">Phone &amp; WhatsApp</strong>
            <a href={`tel:${B.phone}`} class="text-[#F5F5F0] hover:text-[#E5C158] font-semibold transition-colors">
              {B.phoneDisplay}
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <Booking client:load />
      </div>
    </div>
  </section>
</Base>
