---
import Base from '../../layouts/Base.astro';
import { S } from '../../data/catalog.js';
const groups = [...new Set(S.map((service) => service.category))];
const categoryId = (value) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---
<Base
  title="Massage & Spa Treatments in Kalyani Nagar, Pune"
  description="Explore massage, couples, express, body-care, facial and wellness treatments at The Elite Spa Centre in Kalyani Nagar, Pune. Compare durations and indicative starting prices."
>
  <section class="page">
    <span class="eyebrow-light">THE TREATMENT MENU · KALYANI NAGAR</span>
    <h1>Choose your <i>ritual.</i></h1>
    <p>Explore the menu by treatment type. Prices are indicative starting rates in INR; confirm the final price, duration and availability with the centre before booking.</p>
  </section>
  <main id="main-content">
    <nav class="service-jump" aria-label="Treatment categories">
      {groups.map((group) => <a href={'#' + categoryId(group)}>{group} ↓</a>)}
    </nav>
    {groups.map((group) => (
      <section class="service-category" id={categoryId(group)}>
        <div class="section-heading">
          <div><span class="eyebrow">EXPLORE THE MENU</span><h2>{group} <i>rituals.</i></h2></div>
          <a class="text-link" href="/booking/">ASK ABOUT A SESSION ↗</a>
        </div>
        <div class="cards service-cards">
          {S.filter((service) => service.category === group).map((service) => (
            <a class="card" href={'/services/' + service.slug + '/'}>
              <img class="card-image" src={service.image} alt={service.name + ' representative treatment stock photo'} loading="lazy" />
              <div class="card-body">
                <span class="eyebrow">{service.duration} · From ₹{service.price.toLocaleString('en-IN')}</span>
                <h3>{service.name}</h3>
                <p>{service.description}</p>
                <span class="text-link">VIEW TREATMENT DETAILS ↗</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
    <p class="notice">Prices and packages shown on this website are indicative. Your enquiry is confirmed only after the team replies with availability and final pricing.</p>
  </main>
</Base>
