---
import Base from '../../layouts/Base.astro';
import ServicesCatalog from '../../components/ServicesCatalog.tsx';
import { S } from '../../data/catalog.js';
---
<Base
  title="Curated Massage & Spa Rituals in Kalyani Nagar, Pune"
  description="Explore 26 restorative massage, couples sanctuary, express reflexology, and body care rituals at The Elite Spa Centre in Kalyani Nagar, Pune. Starting at ₹999."
>
  <section class="relative pt-32 pb-16 sm:pt-40 sm:pb-20 border-b border-[#D4AF37]/15 bg-gradient-to-b from-[#121215] to-[#09090B]">
    <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
      <p class="text-xs font-semibold tracking-[0.22em] uppercase text-[#D4AF37] mb-3">
        The Treatment Menu · Kalyani Nagar
      </p>
      <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-medium text-[#F5F5F0] leading-[1.04] mb-6">
        Curated Wellness <em class="italic font-normal text-[#D4AF37]">Rituals.</em>
      </h1>
      <p class="text-base sm:text-lg text-[#B0AEA6] max-w-2xl leading-relaxed mb-10">
        Signature 60-minute full-body therapies begin at ₹999, with seamless 30-minute extensions at +₹400. Open daily from 8:00 AM until 3:00 AM.
      </p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl">
        <div class="glass-panel-subtle rounded-2xl p-5">
          <strong class="block font-serif text-3xl text-[#D4AF37] tabular-nums">₹999</strong>
          <span class="text-xs text-[#B0AEA6]">60-Min Full Body</span>
        </div>
        <div class="glass-panel-subtle rounded-2xl p-5">
          <strong class="block font-serif text-3xl text-[#D4AF37] tabular-nums">₹1,399</strong>
          <span class="text-xs text-[#B0AEA6]">90-Min Extended</span>
        </div>
        <div class="glass-panel-subtle rounded-2xl p-5">
          <strong class="block font-serif text-3xl text-[#D4AF37] tabular-nums">₹1,999</strong>
          <span class="text-xs text-[#B0AEA6]">Couples Ritual (60m)</span>
        </div>
        <div class="glass-panel-subtle rounded-2xl p-5">
          <strong class="block font-serif text-3xl text-[#D4AF37] tabular-nums">₹699</strong>
          <span class="text-xs text-[#B0AEA6]">Express Reflexology</span>
        </div>
      </div>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-16 sm:py-24">
    <ServicesCatalog client:load />
  </main>
</Base>
