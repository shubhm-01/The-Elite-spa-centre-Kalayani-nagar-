---
import Base from '../../layouts/Base.astro';import {S} from '../../data/catalog.js';const groups=[...new Set(S.map(x=>x.category))];
---
<Base title="Massage & Spa Services Pune"><section class="page"><small>THE TREATMENT MENU</small><h1>Choose your <i>ritual.</i></h1><p>All prices are starting rates in INR; duration, therapist availability and enhancements can change the final price. Confirm before booking.</p></section><main>{groups.map(g=><section><h2>{g}</h2><div class="list">{S.filter(x=>x.category===g).map(s=><a href={'/services/'+s.slug+'/'}><div><h3>{s.name}</h3><p>{s.duration} · Professional, non-sexual wellness service for adults.</p></div><b>From ₹{s.price.toLocaleString('en-IN')} ↗</b></a>)}</div></section>)}</main></Base>