---
import Base from '../../layouts/Base.astro';
import ServicesCatalog from '../../components/ServicesCatalog.tsx';
---
<Base
  title="Curated Massage & Spa Rituals in Kalyani Nagar, Pune"
  description="Explore 26 massage, couples, express reflexology and body-care rituals at The Elite Spa Centre in Kalyani Nagar, Pune. Selected full-body therapies start at ₹999; express rituals start at ₹699."
>
  <section class="pt-36 pb-20 sm:pt-44 sm:pb-24 border-b border-[#E5C158]/20 bg-gradient-to-b from-[#121215] to-[#09090B]">
    <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
      <h1 class="font-serif text-[44px] sm:text-[56px] lg:text-[68px] font-medium text-[#F5F5F0] leading-[1.04] mb-6">
        Curated Wellness <em class="italic font-normal text-[#E5C158]">Rituals.</em>
      </h1>
      <p class="text-[18px] text-[#F5F5F0]/90 max-w-2xl leading-[1.6] mb-12">
        Signature 60-minute full-body therapies begin at ₹999, with 30-minute extensions at +₹400. Open daily from 8:00 AM until 3:00 AM.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 max-w-5xl">
        <div class="glass-panel-subtle rounded-2xl p-6">
          <strong class="block text-[26px] font-bold text-[#E5C158] tabular-nums">₹999</strong>
          <span class="text-[16px] text-[#F5F5F0]/90">60-Min Full Body</span>
        </div>
        <div class="glass-panel-subtle rounded-2xl p-6">
          <strong class="block text-[26px] font-bold text-[#E5C158] tabular-nums">₹1,399</strong>
          <span class="text-[16px] text-[#F5F5F0]/90">90-Min Extended</span>
        </div>
        <div class="glass-panel-subtle rounded-2xl p-6">
          <strong class="block text-[26px] font-bold text-[#E5C158] tabular-nums">₹1,999</strong>
          <span class="text-[16px] text-[#F5F5F0]/90">Couples Ritual (60m)</span>
        </div>
        <div class="glass-panel-subtle rounded-2xl p-6">
          <strong class="block text-[26px] font-bold text-[#E5C158] tabular-nums">₹699</strong>
          <span class="text-[16px] text-[#F5F5F0]/90">Express Reflexology</span>
        </div>
      </div>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <ServicesCatalog client:load />
  </main>

  <section class="max-w-[1380px] mx-auto px-5 sm:px-8 pb-20 sm:pb-28">
    <div class="glass-panel rounded-3xl p-7 sm:p-10 flex flex-col lg:flex-row lg:items-center justify-between gap-6">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[#D4AF37] mb-2">Getting here · Pune</p>
        <h2 class="font-serif text-3xl sm:text-4xl text-[#F5F5F0] mb-3">Visiting from another Pune neighbourhood?</h2>
        <p class="text-sm text-[#B0AEA6] leading-relaxed">Our only centre is at Vascon Mariplex Mall, Kalyani Nagar. Check the route from Koregaon Park, Viman Nagar, Kharadi, Yerwada or elsewhere before travelling.</p>
      </div>
      <a href="/nearby-areas/" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full border border-[#D4AF37]/45 hover:border-[#D4AF37] text-[#F5F5F0] text-xs font-semibold tracking-[0.1em] uppercase whitespace-nowrap transition-colors">View Pune area guide ↗</a>
    </div>
  </section>
</Base>
