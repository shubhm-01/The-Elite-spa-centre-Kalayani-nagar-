---
import Base from '../../layouts/Base.astro';
import { S } from '../../data/catalog.js';
const groups = [...new Set(S.map((service) => service.category))];
---
<Base
  title="Massage & Spa Services Pune"
  description="Explore 26 massage, body-care, facial and wellness experiences at The Elite Spa Centre in Kalyani Nagar, Pune. Compare session lengths and indicative starting prices."
>
  <section class="page">
    <small>THE TREATMENT MENU</small>
    <h1>Choose your <i>ritual.</i></h1>
    <p>All prices are starting rates in INR; duration, therapist availability and enhancements can change the final price. Confirm before booking.</p>
  </section>
  <main id="main-content">
    {groups.map((group) => (
      <section>
        <h2>{group}</h2>
        <div class="cards service-cards">
          {S.filter((service) => service.category === group).map((service) => (
            <a class="card" href={'/services/' + service.slug + '/'}>
              <img class="card-image" src={service.image} alt={service.name + ' treatment photo'} loading="lazy" />
              <h3>{service.name}</h3>
              <p>{service.description}</p>
              <b>{service.duration} · From ₹{service.price.toLocaleString('en-IN')} ↗</b>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</Base>
