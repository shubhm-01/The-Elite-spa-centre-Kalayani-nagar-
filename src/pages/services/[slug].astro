---
import Base from '../../layouts/Base.astro';
import { S, whatsappUrl } from '../../data/catalog.js';

export function getStaticPaths() {
  return S.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const { service } = Astro.props;
const price = new Intl.NumberFormat('en-IN').format(service.price);
const bookingHref = '/booking/?service=' + encodeURIComponent(service.slug);
const waHref = whatsappUrl(
  `Hello The Elite Spa Centre, I would like to book ${service.name} (${service.duration} • ₹${price}) at your Kalyani Nagar sanctuary.`
);

const serviceSchema = {
  '@type': 'Service',
  '@id': new URL('/services/' + service.slug + '/', Astro.site).href + '#service',
  name: service.name,
  description: service.description,
  serviceType: service.category,
  provider: { '@id': new URL('/', Astro.site).href + '#business' },
  areaServed: { '@type': 'City', name: 'Pune' }
};
---
<Base
  title={service.name + ' in Kalyani Nagar, Pune'}
  description={service.description + ' Book at The Elite Spa Centre, Vascon Mariplex Mall, Kalyani Nagar, Pune.'}
  image={service.image}
  extraStructuredData={[serviceSchema]}
>
  <section class="pt-36 pb-20 sm:pt-44 sm:pb-28 max-w-[1380px] mx-auto px-5 sm:px-8">
    <nav aria-label="Breadcrumb" class="flex items-center gap-3 text-[15px] text-[#F5F5F0]/85 mb-10">
      <a href="/" class="hover:text-[#E5C158]">Home</a>
      <span>/</span>
      <a href="/services/" class="hover:text-[#E5C158]">Rituals</a>
      <span>/</span>
      <span class="text-[#E5C158] font-medium">{service.name}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-6 space-y-8">
        <div class="rounded-3xl overflow-hidden border border-[#E5C158]/25 bg-[#121215] aspect-[4/3]">
          <img
            src={service.image}
            alt={service.name}
            referrerPolicy="no-referrer"
            class="w-full h-full object-cover"
          />
        </div>

        {service.video ? (
          <div class="rounded-3xl overflow-hidden border border-[#E5C158]/22 bg-[#121215] p-5 space-y-4">
            <span class="block text-[16px] font-semibold text-[#E5C158]">
              Ritual Preview
            </span>
            <video
              controls
              playsinline
              preload="none"
              poster={service.videoPoster}
              aria-label={service.name + ' ambient preview'}
              class="w-full rounded-2xl aspect-video object-cover bg-[#09090B]"
            >
              <source src={service.video} type="video/mp4" />
            </video>
          </div>
        ) : null}
      </div>

      <div class="lg:col-span-6 glass-panel rounded-3xl p-8 sm:p-10 space-y-7">
        <h1 class="font-serif text-[40px] sm:text-[52px] font-medium text-[#F5F5F0] leading-[1.08]">
          {service.name}
        </h1>

        <p class="text-[18px] text-[#F5F5F0]/90 leading-[1.6]">
          {service.description}
        </p>

        <div class="py-6 border-y border-[#F5F5F0]/14 space-y-3">
          <strong class="block text-[26px] sm:text-[32px] font-bold text-[#E5C158] tabular-nums">
            {service.duration} • ₹{price}
          </strong>
          <p class="text-[16px] text-[#F5F5F0]/90 leading-[1.6]">
            {service.pricingNote}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 pt-2">
          <a
            href={waHref}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-gold-pulse flex-1 inline-flex items-center justify-center py-4 px-7 rounded-full bg-[#E5C158] hover:bg-[#F2D77E] text-[#09090B] text-[16px] sm:text-[17px] font-semibold transition-colors whitespace-nowrap"
          >
            Book on WhatsApp →
          </a>
          <a
            href={bookingHref}
            class="flex-1 inline-flex items-center justify-center py-4 px-7 rounded-full border border-[#E5C158]/50 hover:border-[#E5C158] text-[#F5F5F0] text-[16px] sm:text-[17px] font-semibold transition-colors whitespace-nowrap"
          >
            Schedule Date &amp; Time
          </a>
        </div>

        <p class="text-[17px] text-[#F5F5F0]/90 leading-[1.6] pt-2">
          Every ritual begins with a personal consultation on pressure, botanical oil blends, and focus areas inside a private candlelit suite at Vascon Mariplex Mall, Kalyani Nagar.
        </p>
      </div>
    </div>
  </section>
</Base>
