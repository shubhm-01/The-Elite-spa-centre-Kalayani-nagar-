---
import Base from '../../layouts/Base.astro';
import { S } from '../../data/catalog.js';

export function getStaticPaths() {
  return S.map((service) => ({
    params: { slug: service.slug },
    props: { service }
  }));
}

const service = Astro.props.service;
const price = new Intl.NumberFormat('en-IN').format(service.price);
const bookingHref = '/booking/?service=' + encodeURIComponent(service.slug);
---
<Base title={service.name} description={service.description}>
  <section class="page service-hero">
    <img class="service-detail-image" src={service.image} alt={service.name + ' representative treatment photograph'} />
    <div>
      <small>{service.category} · {service.duration}</small>
      <h1>{service.name}</h1>
      <p>{service.description}</p>
      {service.video ? (
        <div class="treatment-video">
          <small>SEE A TREATMENT PREVIEW</small>
          <video controls playsinline preload="none" poster={service.videoPoster} aria-label={service.name + ' treatment preview'}>
            <source src={service.video} type="video/mp4" />
            Your browser does not support embedded video. <a href={service.videoPage}>Watch the preview on Pexels</a>.
          </video>
          <p class="media-credit">Video by {service.videoCredit} on <a href={service.videoPage} target="_blank" rel="noopener noreferrer">Pexels ↗</a></p>
        </div>
      ) : null}
      <h2>Starting at ₹{price}</h2>
      <a class="btn" href={bookingHref}>Request this treatment</a>
    </div>
  </section>
  <main id="main-content">
    <h2>Your Elite experience</h2>
    <p>Our team will discuss your preferences, pressure level and comfort considerations before the session. All treatments are professional, non-sexual wellness services for adults, with consent, appropriate draping and clear boundaries.</p>
    <p>Final rate and appointment availability are confirmed on WhatsApp.</p>
    <a class="btn" href={bookingHref}>Continue to booking</a>
  </main>
  <p class="media-note">The photograph and any video shown on this page are illustrative Pexels stock media, not footage of this specific spa or its staff.</p>
</Base>
