---
import Base from '../../layouts/Base.astro';
import { OFFERS } from '../../data/offers.js';
import { whatsappUrl } from '../../data/catalog.js';
---
<Base
  title="Curated Spa Bundles & Privilege Offers in Kalyani Nagar, Pune"
  description="Discover curated spa packages at The Elite Spa Centre in Kalyani Nagar, Pune — including The Everyday Reset (₹1,699), The Couple Retreat (₹3,499), and The Glow Ritual (₹1,699)."
>
  <section class="pt-36 pb-20 sm:pt-44 sm:pb-24 border-b border-[#D4AF7A]/20 bg-gradient-to-b from-[#161412] to-[#0B0A09]">
    <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
      <p class="text-[15px] font-semibold tracking-[0.06em] uppercase text-[#D4AF7A] mb-3">
        Transparent Privilege Pricing
      </p>
      <h1 class="font-serif text-[44px] sm:text-[56px] lg:text-[68px] font-medium text-[#F4EFE6] leading-[1.04] mb-5">
        Curated <em class="italic font-normal text-[#E5C158]">Ritual Bundles.</em>
      </h1>
      <p class="text-[18px] text-[#F4EFE6]/90 max-w-2xl leading-[1.6]">
        Thoughtfully paired full-body therapies, facials, couples retreats, and apothecary essentials with clear, itemized savings.
      </p>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {OFFERS.map((offer) => {
        const waHref = whatsappUrl(
          `Hello The Elite Spa Centre, I would like to book ${offer.title} (${offer.code}) at ₹${offer.offerPrice.toLocaleString('en-IN')}. Included: ${offer.items.join(' + ')}.`
        );
        return (
          <article class="card-hover-zoom card-hover-glow rounded-3xl bg-[#161412] border border-[#D4AF7A]/24 overflow-hidden flex flex-col justify-between transition-colors">
            <div class="relative aspect-[4/3] overflow-hidden bg-[#1F1C19]">
              <img
                src={offer.image}
                alt={offer.title}
                loading="lazy"
                referrerPolicy="no-referrer"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#161412] via-transparent to-transparent" />
              <span class="absolute top-5 right-5 py-2 px-4 rounded-full bg-[#E5C158] text-[#0B0A09] text-[15px] font-bold tabular-nums">
                Save ₹{offer.savings.toLocaleString('en-IN')}
              </span>
            </div>

            <div class="p-8 flex flex-col flex-1 justify-between gap-6">
              <div class="space-y-4">
                <h2 class="font-serif text-[30px] sm:text-[34px] font-medium text-[#F4EFE6] leading-tight">
                  {offer.title}
                </h2>
                <ul class="space-y-3 text-[17px] text-[#F4EFE6]/90 leading-[1.55]">
                  {offer.items.map((item) => (
                    <li class="flex items-start gap-3">
                      <span class="text-[#E5C158] font-bold" aria-hidden="true">✓</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
                <div class="rounded-2xl bg-[#0B0A09]/85 border border-[#D4AF7A]/28 px-4 py-3 text-[15px] font-medium text-[#F4EFE6] tabular-nums">
                  {offer.priceBreakup}
                </div>
              </div>

              <div class="pt-6 border-t border-[#F4EFE6]/12 flex flex-wrap items-center justify-between gap-4">
                <div class="flex items-baseline gap-3">
                  <strong class="text-[26px] font-bold text-[#E5C158] tabular-nums">
                    ₹{offer.offerPrice.toLocaleString('en-IN')}
                  </strong>
                  <span class="text-[17px] text-[#F4EFE6]/65 line-through tabular-nums">
                    ₹{offer.regularPrice.toLocaleString('en-IN')}
                  </span>
                </div>

                <a
                  href={waHref}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="min-h-[52px] inline-flex items-center justify-center py-3.5 px-7 rounded-full bg-[#E5C158] hover:bg-[#F0D58C] active:scale-[0.98] text-[#0B0A09] text-[16px] font-semibold transition-all"
                >
                  Book Bundle →
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </main>
</Base>
