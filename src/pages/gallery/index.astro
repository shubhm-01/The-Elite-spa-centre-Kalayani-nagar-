---
import Base from '../../layouts/Base.astro';
import { S } from '../../data/catalog.js';
const ambience = [
  {
    title: 'A quiet massage room',
    alt: 'Illustrative stock photograph of a calm massage room with soft natural light',
    image: 'https://images.pexels.com/photos/11774389/pexels-photo-11774389.jpeg?auto=compress&w=1260&h=750&dpr=1',
    photographer: 'Tugce Erten Barrett',
    creator: 'https://www.pexels.com/@tugce-erten-barrett-211955335/',
    source: 'https://www.pexels.com/photo/interior-design-of-a-massage-room-11774389/'
  },
  {
    title: 'Spa interior inspiration',
    alt: 'Illustrative stock photograph of a contemporary spa interior with loungers and greenery',
    image: 'https://images.pexels.com/photos/7031704/pexels-photo-7031704.jpeg?auto=compress&w=1260&h=750&dpr=1',
    photographer: 'Max Vakhtbovych',
    creator: 'https://www.pexels.com/@artbovich/',
    source: 'https://www.pexels.com/photo/interior-of-modern-luxury-spa-zone-with-loungers-and-bathtubs-7031704/'
  },
  {
    title: 'Treatment room details',
    alt: 'Illustrative stock photograph of a modern spa treatment room with ambient lighting',
    image: 'https://images.pexels.com/photos/35546242/pexels-photo-35546242/free-photo-of-modern-spa-treatment-room-with-elegant-design.jpeg?auto=compress&w=1260&h=750&dpr=1',
    photographer: 'Triệt Lông Club Hair Removal by TL',
    creator: 'https://www.pexels.com/@tri-t-long-club-hair-removal-by-tl-2158697365/',
    source: 'https://www.pexels.com/photo/modern-spa-treatment-room-with-elegant-design-35546242/'
  }
];
---
<Base
  title="Spa Gallery & Treatment Inspiration in Pune"
  description="Browse treatment inspiration and spa ambience photography for The Elite Spa Centre in Kalyani Nagar, Pune. Stock images are credited and clearly labelled as illustrative, not actual venue photos."
>
  <section class="page page-gallery">
    <span class="eyebrow-light">A GLIMPSE OF THE EXPERIENCE</span>
    <h1>The art of <i>unwinding.</i></h1>
    <p>Explore the treatment menu through a visual collection of massage, body-care, facial and spa-inspired photography.</p>
  </section>
  <main id="main-content">
    <section class="gallery-intro">
      <span class="eyebrow">THE VISUAL EDIT</span>
      <h2>Spaces, textures &amp; <i>rituals.</i></h2>
      <p>Some photographs are sourced from Pexels and are used as illustrative inspiration. They are not photographs of The Elite Spa Centre, its actual rooms, facilities, therapists or team.</p>
    </section>
    <section class="gallery-ambience-section">
      <div class="gallery-ambience-grid">
        {ambience.map((photo) => (
          <figure class="gallery-item gallery-ambience">
            <a href={photo.source} target="_blank" rel="noopener noreferrer">
              <img src={photo.image} alt={photo.alt} loading="lazy" />
            </a>
            <figcaption>
              <strong>{photo.title}</strong>
              <span>Illustrative stock photo · {photo.photographer}</span>
              <a href={photo.source} target="_blank" rel="noopener noreferrer">View original on Pexels ↗</a>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
    <section class="gallery-treatment-section">
      <div class="section-heading">
        <div><span class="eyebrow">TREATMENT INSPIRATION</span><h2>Find the ritual that <i>speaks to you.</i></h2><p>Each image is a representative visual linked to its treatment information page.</p></div>
        <a class="text-link" href="/services/">EXPLORE ALL TREATMENTS ↗</a>
      </div>
      <div class="gallery">
        {S.map((service) => (
          <figure class="gallery-item">
            <a href={'/services/' + service.slug + '/'}>
              <img src={service.image} alt={service.name + ' representative treatment stock photograph'} loading="lazy" />
            </a>
            <figcaption>
              <strong>{service.name}</strong>
              <span>{service.duration} · {service.category} · Representative stock image</span>
              <a href={'/services/' + service.slug + '/'}>View treatment ↗</a>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
    <p class="image-disclaimer">Photography credit and source links are provided for the additional Pexels ambience photographs above. The images are visual references only and must not be read as a record of this particular business location.</p>
  </main>
</Base>
