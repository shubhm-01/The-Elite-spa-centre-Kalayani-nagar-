---
import Base from '../../layouts/Base.astro';
import { S, SENSORY_GALLERY } from '../../data/catalog.js';
---
<Base
  title="The Sensory Gallery | The Elite Spa Centre, Kalyani Nagar"
  description="Step inside the candlelit suites, volcanic stone therapies, botanical oil infusions, and tranquil ambience of The Elite Spa Centre in Kalyani Nagar, Pune."
>
  <section class="pt-32 pb-16 sm:pt-40 sm:pb-20 border-b border-[#D4AF37]/15 bg-gradient-to-b from-[#121215] to-[#09090B]">
    <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
      <p class="text-xs font-semibold tracking-[0.22em] uppercase text-[#D4AF37] mb-3">
        The Sensory Gallery
      </p>
      <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-medium text-[#F5F5F0] leading-[1.04] mb-5">
        The Art of <em class="italic font-normal text-[#D4AF37]">Unwinding.</em>
      </h1>
      <p class="text-base sm:text-lg text-[#B0AEA6] max-w-2xl leading-relaxed">
        Candlelit private chambers, warm basalt stones, pure botanical infusions, and serene rituals curated for complete stillness in Kalyani Nagar.
      </p>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-16 sm:py-24 space-y-20">
    <section>
      <div class="mb-10">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[#D4AF37] mb-2">Sanctuary Ambience</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-medium text-[#F5F5F0]">
          Spaces &amp; <em class="italic font-normal text-[#D4AF37]">Textures.</em>
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {SENSORY_GALLERY.map((item) => (
          <figure class="group relative rounded-2xl overflow-hidden border border-[#D4AF37]/20 bg-[#121215] h-80">
            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              referrerPolicy="no-referrer"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-108"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#09090B]/90 via-transparent to-transparent" />
            <figcaption class="absolute bottom-0 inset-x-0 p-5">
              <strong class="block font-serif text-xl text-[#F5F5F0]">{item.title}</strong>
              <span class="block text-xs text-[#B0AEA6] mt-0.5">{item.subtitle}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[#D4AF37] mb-2">Ritual Showcase</p>
          <h2 class="font-serif text-3xl sm:text-4xl font-medium text-[#F5F5F0]">
            Signature <em class="italic font-normal text-[#D4AF37]">Experiences.</em>
          </h2>
        </div>
        <a href="/services/" class="text-xs font-semibold tracking-[0.14em] uppercase text-[#D4AF37] hover:text-[#E8CB6D]">
          Explore All {S.length} Rituals ↗
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {S.map((service) => (
          <a
            href={`/services/${service.slug}/`}
            class="group relative rounded-2xl overflow-hidden border border-[#F5F5F0]/10 hover:border-[#D4AF37]/45 bg-[#121215] h-72 block transition-colors"
          >
            <img
              src={service.image}
              alt={service.name}
              loading="lazy"
              referrerPolicy="no-referrer"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-108"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#09090B]/95 via-[#09090B]/20 to-transparent" />
            <div class="absolute bottom-0 inset-x-0 p-5 flex items-end justify-between gap-3">
              <div>
                <span class="block text-[11px] tracking-[0.14em] uppercase text-[#D4AF37]">{service.duration}</span>
                <strong class="block font-serif text-2xl text-[#F5F5F0] group-hover:text-[#E8CB6D] transition-colors">
                  {service.name}
                </strong>
              </div>
              <span class="font-serif text-xl font-semibold text-[#F5F5F0] tabular-nums shrink-0">
                ₹{service.price.toLocaleString('en-IN')}
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
