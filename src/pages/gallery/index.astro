---
import Base from '../../layouts/Base.astro';
import { S } from '../../data/catalog.js';
---
<Base
  title="Spa Gallery Pune"
  description="Explore treatment-specific massage, body-care, facial and wellness imagery for The Elite Spa Centre in Kalyani Nagar, Pune."
>
  <section class="page">
    <small>A GLIMPSE OF THE EXPERIENCE</small>
    <h1>The art of <i>unwinding.</i></h1>
  </section>
  <main id="main-content" class="gallery">
    {S.map((service) => (
      <figure class="gallery-item">
        <img src={service.image} alt={service.name + ' representative treatment photograph'} loading="lazy" />
        <figcaption>
          <strong>{service.name}</strong>
          <span>{service.duration} · {service.category}</span>
          <a href={'/services/' + service.slug + '/'}>View treatment ↗</a>
        </figcaption>
      </figure>
    ))}
  </main>
  <p class="media-note">These are illustrative stock photographs sourced from Pexels, not photographs of the spa premises or its staff.</p>
</Base>
