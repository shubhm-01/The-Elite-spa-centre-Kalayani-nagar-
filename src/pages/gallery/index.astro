---
import Base from '../../layouts/Base.astro';
import { S, SENSORY_GALLERY } from '../../data/catalog.js';
---
<Base
  title="The Sensory Gallery | The Elite Spa Centre, Kalyani Nagar"
  description="Step inside the candlelit suites, volcanic stone therapies, botanical oil infusions, and tranquil ambience of The Elite Spa Centre in Kalyani Nagar, Pune."
>
  <section class="pt-36 pb-20 sm:pt-44 sm:pb-24 border-b border-[#D4AF7A]/20 bg-gradient-to-b from-[#161412] to-[#0B0A09]">
    <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
      <p class="text-[15px] font-semibold tracking-[0.06em] uppercase text-[#D4AF7A] mb-3">
        Inside Vascon Mariplex Mall
      </p>
      <h1 class="font-serif text-[44px] sm:text-[56px] lg:text-[68px] font-medium text-[#F4EFE6] leading-[1.04] mb-5">
        The Sensory <em class="italic font-normal text-[#E5C158]">Gallery.</em>
      </h1>
      <p class="text-[18px] text-[#F4EFE6]/90 max-w-2xl leading-[1.6]">
        Candlelit private chambers, warm basalt stones, and pure botanical infusions curated for complete stillness in Kalyani Nagar.
      </p>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-20 sm:py-28 space-y-24">
    <section>
      <h2 class="font-serif text-[34px] sm:text-[42px] lg:text-[48px] font-medium text-[#F4EFE6] mb-10">
        Spaces &amp; <em class="italic font-normal text-[#E5C158]">Atmosphere.</em>
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {SENSORY_GALLERY.map((item) => (
          <figure class="card-hover-zoom card-hover-glow relative rounded-3xl overflow-hidden border border-[#D4AF7A]/22 bg-[#161412] h-[380px] sm:h-[440px]">
            <img
              src={item.image}
              alt={item.title}
              loading="lazy"
              referrerPolicy="no-referrer"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B0A09]/92 via-transparent to-transparent" />
            <figcaption class="absolute bottom-0 inset-x-0 p-7 space-y-1.5">
              <span class="block text-[15px] font-semibold text-[#E5C158]">
                {item.categoryTag}
              </span>
              <strong class="block font-serif text-[26px] sm:text-[28px] font-medium text-[#F4EFE6]">
                {item.title}
              </strong>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <h2 class="font-serif text-[34px] sm:text-[42px] lg:text-[48px] font-medium text-[#F4EFE6]">
          Signature <em class="italic font-normal text-[#E5C158]">Rituals.</em>
        </h2>
        <a href="/services/" class="text-[16px] font-semibold text-[#E5C158] hover:text-[#F0D58C]">
          Explore All {S.length} Rituals →
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {S.map((service) => (
          <a
            href={`/services/${service.slug}/`}
            class="card-hover-zoom card-hover-glow relative rounded-3xl overflow-hidden border border-[#F4EFE6]/14 bg-[#161412] h-[340px] sm:h-[380px] block transition-colors"
          >
            <img
              src={service.image}
              alt={service.name}
              loading="lazy"
              referrerPolicy="no-referrer"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B0A09]/92 via-[#0B0A09]/20 to-transparent" />
            <div class="absolute bottom-0 inset-x-0 p-7 flex flex-wrap items-end justify-between gap-4">
              <strong class="font-serif text-[26px] sm:text-[28px] font-medium text-[#F4EFE6]">
                {service.name}
              </strong>
              <span class="text-[20px] font-bold text-[#E5C158] tabular-nums shrink-0">
                {service.duration} • ₹{service.price.toLocaleString('en-IN')}
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
