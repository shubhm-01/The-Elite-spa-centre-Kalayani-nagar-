---
import Base from '../layouts/Base.astro';import {S,P} from '../data/catalog.js';
---
<Base title="Luxury Spa & Massage in Kalyani Nagar"><section class="hero hero-video"><video class="hero-film" autoplay muted loop playsinline poster="https://images.pexels.com/photos/5240675/pexels-photo-5240675.jpeg?w=1800"><source src="https://assets.mixkit.co/videos/52167/52167-720.mp4" type="video/mp4"/></video><div class="hero-shade"></div><div class="hero-copy"><small>KALYANI NAGAR · PUNE</small><h1>Make space<br/>for <i>yourself.</i></h1><p>Massage, restorative rituals and everyday luxury. Your pause in the heart of Pune.</p><a class="btn" href="/booking/">Reserve your escape ↗</a> <a class="btn outline" href="/services/">Explore treatments</a><p class="hours">OPEN DAILY · 07:00 AM — 02:00 AM</p></div></section><main><section><small>THE TREATMENT EDIT</small><h2>Find your <i>ritual.</i></h2><div class="cards">{S.slice(0,6).map(s=><a class="card" href={'/services/'+s.slug+'/'}><img class="card-image" src={s.image} alt={s.name+' spa treatment'} loading="lazy"/><h3>{s.name}</h3><p>{s.duration} · From ₹{s.price.toLocaleString('en-IN')}</p></a>)}</div><p><a href="/services/">VIEW ALL SERVICES ↗</a></p></section><section class="banner"><small>FIRST VISIT · INTRODUCTORY PACKAGES</small><h2>A little something <i>special.</i></h2><p>Explore introductory rates and seasonal offers. Terms and eligibility apply.</p><a class="btn" href="/offers/">Explore offers ↗</a></section><section><small>THE WELLNESS SHOP</small><h2>Bring the ritual <i>home.</i></h2><div class="cards">{P.slice(0,6).map(p=><article class="card"><img class="card-image" src={p.image} alt={p.name+' product photo'} loading="lazy"/><h3>{p.name}</h3><p>₹{p.price.toLocaleString('en-IN')} · Indicative</p></article>)}</div><a class="btn" href="/shop/">Shop all wellness products ↗</a></section></main></Base>