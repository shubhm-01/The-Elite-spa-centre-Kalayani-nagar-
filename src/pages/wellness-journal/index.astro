---
import Base from '../../layouts/Base.astro';
import { JOURNAL } from '../../data/journal.js';
---
<Base
  title="The Wellness Journal | Spa & Massage Guides, Pune"
  description="Curated guides on massage rituals, pressure customization, couples spa evenings, and botanical self-care from The Elite Spa Centre in Kalyani Nagar, Pune."
>
  <section class="pt-36 pb-20 sm:pt-44 sm:pb-24 border-b border-[#E5C158]/20 bg-gradient-to-b from-[#121215] to-[#09090B]">
    <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
      <h1 class="font-serif text-[44px] sm:text-[56px] lg:text-[68px] font-medium text-[#F5F5F0] leading-[1.04] mb-5">
        The Wellness <em class="italic font-normal text-[#E5C158]">Journal.</em>
      </h1>
      <p class="text-[18px] text-[#F5F5F0]/90 max-w-2xl leading-[1.6]">
        Editorial notes on restorative bodywork, essential oil pairings, and getting the most out of every visit to our sanctuary.
      </p>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {JOURNAL.map((article) => (
        <a
          href={`/wellness-journal/${article.slug}/`}
          class="group glass-panel rounded-3xl p-8 flex flex-col justify-between gap-6 hover:border-[#E5C158]/60 transition-colors"
        >
          <div class="space-y-4">
            <h2 class="font-serif text-[28px] sm:text-[32px] font-medium text-[#F5F5F0] group-hover:text-[#E5C158] transition-colors leading-tight">
              {article.title}
            </h2>
            <p class="text-[17px] text-[#F5F5F0]/90 leading-[1.6]">
              {article.excerpt}
            </p>
          </div>
          <span class="text-[16px] font-semibold text-[#E5C158]">
            Read Guide →
          </span>
        </a>
      ))}
    </div>
  </main>
</Base>
