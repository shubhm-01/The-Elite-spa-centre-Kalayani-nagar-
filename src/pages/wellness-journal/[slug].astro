---
import Base from '../../layouts/Base.astro';
import { JOURNAL } from '../../data/journal.js';
import { S } from '../../data/catalog.js';

export function getStaticPaths() {
  return JOURNAL.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const relatedServices = article.related.map((slug) => S.find((service) => service.slug === slug)).filter(Boolean);
---
<Base title={article.title} description={article.excerpt}>
  <section class="pt-32 pb-12 sm:pt-40 sm:pb-16 border-b border-[#D4AF37]/15 bg-gradient-to-b from-[#121215] to-[#09090B]">
    <div class="max-w-4xl mx-auto px-5 sm:px-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-[#B0AEA6] mb-6">
        <a href="/" class="hover:text-[#D4AF37]">Home</a>
        <span>/</span>
        <a href="/wellness-journal/" class="hover:text-[#D4AF37]">Journal</a>
        <span>/</span>
        <span class="text-[#F5F5F0]">{article.category}</span>
      </nav>
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[#D4AF37] mb-3">{article.category}</p>
      <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-medium text-[#F5F5F0] leading-[1.08] mb-5">
        {article.title}
      </h1>
      <p class="text-base sm:text-lg text-[#B0AEA6] leading-relaxed">{article.intro}</p>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-16 sm:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <article class="lg:col-span-8 space-y-10">
        {article.sections.map((section) => (
          <section class="space-y-4">
            <h2 class="font-serif text-3xl text-[#F5F5F0]">{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p class="text-base text-[#B0AEA6] leading-relaxed">{paragraph}</p>
            ))}
          </section>
        ))}
      </article>

      <aside class="lg:col-span-4">
        <div class="glass-panel rounded-3xl p-7 space-y-5 sticky top-28">
          <span class="text-xs font-semibold tracking-[0.18em] uppercase text-[#D4AF37]">
            Suggested Rituals
          </span>
          <h3 class="font-serif text-2xl text-[#F5F5F0]">Experience It Yourself</h3>
          <div class="space-y-3">
            {relatedServices.map((service) => (
              <a
                href={`/services/${service.slug}/`}
                class="flex items-center justify-between p-3.5 rounded-xl bg-[#09090B]/70 border border-[#F5F5F0]/10 hover:border-[#D4AF37]/50 text-sm text-[#F5F5F0] transition-colors"
              >
                <span>{service.name}</span>
                <span class="text-[#D4AF37] font-serif text-lg tabular-nums">₹{service.price.toLocaleString('en-IN')}</span>
              </a>
            ))}
          </div>
          <a
            href="/booking/"
            class="w-full inline-flex items-center justify-center px-5 py-3.5 rounded-full bg-[#D4AF37] hover:bg-[#E8CB6D] text-[#09090B] text-xs font-bold tracking-[0.1em] uppercase transition-colors"
          >
            Reserve Your Session ↗
          </a>
        </div>
      </aside>
    </div>
  </main>
</Base>
