---
import Base from '../../layouts/Base.astro';
import { JOURNAL } from '../../data/journal.js';
import { S } from '../../data/catalog.js';

export function getStaticPaths() {
  return JOURNAL.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}

const { article } = Astro.props;
const relatedServices = article.related.map((slug) => S.find((service) => service.slug === slug)).filter(Boolean);
---
<Base title={article.title} description={article.excerpt}>
  <section class="pt-36 pb-16 sm:pt-44 sm:pb-20 border-b border-[#E5C158]/20 bg-gradient-to-b from-[#121215] to-[#09090B]">
    <div class="max-w-4xl mx-auto px-5 sm:px-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-3 text-[15px] text-[#F5F5F0]/85 mb-8">
        <a href="/" class="hover:text-[#E5C158]">Home</a>
        <span>/</span>
        <a href="/wellness-journal/" class="hover:text-[#E5C158]">Journal</a>
        <span>/</span>
        <span class="text-[#E5C158]">{article.category}</span>
      </nav>
      <h1 class="font-serif text-[40px] sm:text-[52px] lg:text-[60px] font-medium text-[#F5F5F0] leading-[1.08] mb-5">
        {article.title}
      </h1>
      <p class="text-[18px] text-[#F5F5F0]/90 leading-[1.6]">{article.intro}</p>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-20 sm:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <article class="lg:col-span-8 space-y-10">
        {article.sections.map((section) => (
          <section class="space-y-4">
            <h2 class="font-serif text-[32px] sm:text-[36px] text-[#F5F5F0]">{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p class="text-[18px] text-[#F5F5F0]/90 leading-[1.65]">{paragraph}</p>
            ))}
          </section>
        ))}
      </article>

      <aside class="lg:col-span-4">
        <div class="glass-panel rounded-3xl p-7 sm:p-8 space-y-6 sticky top-28">
          <h3 class="font-serif text-[28px] text-[#F5F5F0]">Experience It Yourself</h3>
          <div class="space-y-3.5">
            {relatedServices.map((service) => (
              <a
                href={`/services/${service.slug}/`}
                class="flex items-center justify-between gap-3 p-4 rounded-2xl bg-[#09090B]/80 border border-[#F5F5F0]/14 hover:border-[#E5C158]/60 text-[16px] text-[#F5F5F0] transition-colors"
              >
                <span class="font-medium">{service.name}</span>
                <span class="text-[#E5C158] font-bold text-[18px] tabular-nums shrink-0">₹{service.price.toLocaleString('en-IN')}</span>
              </a>
            ))}
          </div>
          <a
            href="/booking/"
            class="w-full inline-flex items-center justify-center py-4 px-7 rounded-full bg-[#E5C158] hover:bg-[#F2D77E] text-[#09090B] text-[16px] font-semibold transition-colors"
          >
            Reserve Your Session →
          </a>
        </div>
      </aside>
    </div>
  </main>
</Base>
