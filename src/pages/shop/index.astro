---
import Base from '../../layouts/Base.astro';
import ShopCatalog from '../../components/ShopCatalog.tsx';
---
<Base
  title="The Wellness Apothecary & Spa Shop in Kalyani Nagar, Pune"
  description="Shop aromatic massage oils, sandalwood & lavender blends, Himalayan bath salts, botanical scrubs, and luxury gift hampers from The Elite Spa Centre, Pune."
>
  <section class="pt-36 pb-20 sm:pt-44 sm:pb-24 border-b border-[#E5C158]/20 bg-gradient-to-b from-[#121215] to-[#09090B]">
    <div class="max-w-[1380px] mx-auto px-5 sm:px-8">
      <h1 class="font-serif text-[44px] sm:text-[56px] lg:text-[68px] font-medium text-[#F5F5F0] leading-[1.04] mb-5">
        The Wellness <em class="italic font-normal text-[#E5C158]">Apothecary.</em>
      </h1>
      <p class="text-[18px] text-[#F5F5F0]/90 max-w-2xl leading-[1.6]">
        Pure aromatic massage oils, mineral bath soaks, botanical body scrubs, and curated spa gift boxes ready for pickup or direct WhatsApp delivery.
      </p>
    </div>
  </section>

  <main class="max-w-[1380px] mx-auto px-5 sm:px-8 py-20 sm:py-28">
    <ShopCatalog client:load />
  </main>
</Base>
