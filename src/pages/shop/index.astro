---
import Base from '../../layouts/Base.astro';import {P} from '../../data/catalog.js';
const groups=[...new Set(P.map(p=>p.category))];
---
<Base title="Spa Products Shop Pune"><section class="page"><small>THE ELITE WELLNESS SHOP</small><h1>Bring the ritual <i>home.</i></h1><p>Massage oils, essential oils, aromatherapy, skincare, bath & body, tools and gift sets.</p></section><main><div class="shop-top"><p class="notice">Prices shown are indicative; actual brand, size, stock, delivery and final price are confirmed before payment. Product photographs are representative category imagery, not confirmed pack shots.</p><label class="shop-search">Search products <input id="shop-search" type="search" placeholder="Search oils, skincare, bath salts…"/></label><div class="cart-bar"><b>Cart <span id="cart-count">0</span></b><button id="cart-checkout" class="btn">WhatsApp checkout ↗</button></div></div>{groups.map(g=><section class="shop-group"><h2>{g}</h2><div class="cards">{P.filter(p=>p.category===g).map(p=><article class="card product-card" data-name={p.name.toLowerCase()}><img class="card-image product-image" src={p.image} alt={p.name+' category photo'} loading="lazy"/><h3>{p.name}</h3><b>₹{p.price.toLocaleString('en-IN')}</b><p>{p.category} · Indicative price</p><button class="btn add-cart" data-name={p.name} data-price={p.price}>Add to cart +</button></article>)}</div></section>)}</main><script is:inline>
const cart=new Map();const count=document.getElementById('cart-count');function draw(){count.textContent=[...cart.values()].reduce((n,x)=>n+x.qty,0);document.querySelectorAll('.add-cart').forEach(b=>{const x=cart.get(b.dataset.name);b.textContent=x?'Added · '+x.qty+' (add more +)':'Add to cart +';});}
document.querySelectorAll('.add-cart').forEach(b=>b.addEventListener('click',()=>{const x=cart.get(b.dataset.name)||{price:Number(b.dataset.price),qty:0};x.qty++;cart.set(b.dataset.name,x);draw();}));
document.getElementById('cart-checkout').addEventListener('click',()=>{if(!cart.size){alert('Please add products to your cart first.');return;}const rows=[...cart].map(([n,x])=>n+' × '+x.qty+' — ₹'+(x.price*x.qty)).join('\n');const total=[...cart.values()].reduce((n,x)=>n+x.price*x.qty,0);const msg='Hello The Elite Spa Centre, I would like to enquire/order:\n'+rows+'\nIndicative total: ₹'+total+'\nPlease confirm actual stock, brand, pack size, delivery and final price.';location.href='https://wa.me/919199561258?text='+encodeURIComponent(msg);});
document.getElementById('shop-search').addEventListener('input',e=>{const q=e.target.value.toLowerCase();document.querySelectorAll('.product-card').forEach(c=>c.hidden=!c.dataset.name.includes(q));document.querySelectorAll('.shop-group').forEach(g=>g.hidden=!g.querySelector('.product-card:not([hidden])'));});
</script></Base>